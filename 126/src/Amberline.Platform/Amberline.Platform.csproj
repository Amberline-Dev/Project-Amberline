<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Amberline.Platform</AssemblyName>
    <RootNamespace>Amberline.Platform</RootNamespace>
    <DefineConstants>$(DefineConstants);AMBERLINE_HOST_FOLDERS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Batch 797: the files both patch lines share are in host/. -->
    <Compile Include="$(HostRoot)src\Amberline.Platform\**\*.cs" LinkBase="host" />
    <!-- The setup page's folder checks (HostFolders.cs) use the companion's own client pins, AIR layout, folder hazards and language
         lookup. These dependency-free files are compiled in as source; AMBERLINE_HOST_FOLDERS gives them their own namespace here, so
         the test assembly, which sees both projects, never meets one type name twice. -->
    <Compile Include="$(HostRoot)src\Amberline.AirCompanion\RetailClients.cs" Link="Folders\RetailClients.cs" />
    <!-- Batch 815: this patch line's values for RetailClients (the wording, the game executable's SHA-256, the client bundle). -->
    <Compile Include="..\Amberline.AirCompanion\RetailClients.Line.cs" Link="Folders\RetailClients.Line.cs" />
    <Compile Include="..\Amberline.AirCompanion\AirSourceLayout.cs" Link="Folders\AirSourceLayout.cs" />
    <Compile Include="$(HostRoot)src\Amberline.AirCompanion\GameFolderReport.cs" Link="Folders\GameFolderReport.cs" />
    <Compile Include="$(HostRoot)src\Amberline.AirCompanion\GameLanguagePack.cs" Link="Folders\GameLanguagePack.cs" />
    <!-- Batch 637: the host's one-folder install moves the game and AIR client with the player installer's move code. -->
    <Compile Include="..\Amberline.AirCompanion\FolderMove.cs" Link="Folders\FolderMove.cs" />
    <!-- Batch 761, task 8: the host's optional 2011 launcher folder (HostFolders' row) and its file sharing (HostFileShare) use the launcher's accepted files. -->
    <Compile Include="..\Amberline.AirCompanion\ClassicLauncherFiles.cs" Link="Folders\ClassicLauncherFiles.cs" />
    <!-- Batch 765: the host's "Use the client zip" button and its command-line option unpack the client zip with the player installer's code. -->
    <Compile Include="$(HostRoot)src\Amberline.AirCompanion\ClientZip.cs" Link="Folders\ClientZip.cs" />
    <!-- Batch 857: the host's install and its start lock the install folder with the player installer's lock (InstallLock.cs). -->
    <Compile Include="$(HostRoot)src\Amberline.AirCompanion\InstallLock.cs" Link="Folders\InstallLock.cs" />
    <!-- Batch 917: Users, Add a user and the sign-up page give the invite link the player app reads, with the app's own codec and this line's values. -->
    <Compile Include="$(HostRoot)src\Amberline.AirCompanion\InviteLink.cs" Link="Folders\InviteLink.cs" />
    <Compile Include="..\Amberline.AirCompanion\InviteLink.Line.cs" Link="Folders\InviteLink.Line.cs" />
    <ProjectReference Include="../Amberline.Host/Amberline.Host.csproj" />
    <ProjectReference Include="../Amberline.Rtmp/Amberline.Rtmp.csproj" />
  </ItemGroup>
</Project>
